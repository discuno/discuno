{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "checkJs": false,
    "incremental": false,
    "types": ["vitest/globals", "@testing-library/jest-dom", "node"]
  },
  "include": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/__tests__/**/*.ts",
    "src/__tests__/**/*.tsx",
    "e2e/**/*.ts",
    "playwright.config.ts",
    "test-utils.ts",
    "test-utils.tsx"
  ],
  "exclude": ["node_modules", "coverage", ".next"]
}
