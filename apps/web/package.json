    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "feed": "^6.0.0",
    "geist": "^1.7.2",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.11.1",
