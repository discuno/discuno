{
  "name": "@discuno/web",
  "version": "0.1.0",
  "private": true,
  "description": "Discuno web application - a modern platform for scheduling mentorship sessions with integrated calendar management",
  "keywords": [
    "nextjs",
    "scheduling",
    "mentorship",
    "cal.com",
    "education",
    "typescript",
    "react"
  ],
  "homepage": "https://github.com/discuno/discuno#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/discuno/discuno.git",
    "directory": "apps/web"
  },
  "bugs": {
    "url": "https://github.com/discuno/discuno/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Discuno Team",
    "url": "https://github.com/discuno"
  },
  "engines": {
    "node": "24.x",
    "pnpm": ">=11.13.0"
  },
  "type": "module",
  "scripts": {
    "build": "next build",
    "check": "eslint . && tsc --noEmit",
    "db:push": "tsx scripts/db-push.ts",
    "db:seed": "SKIP_ENV_VALIDATION=1 tsx scripts/db-seed.ts",
    "db:reset:local": "SKIP_ENV_VALIDATION=1 tsx scripts/db-reset.ts local",
    "db:reset:preview": "SKIP_ENV_VALIDATION=1 tsx scripts/db-reset.ts preview",
    "db:reset:test": "SKIP_ENV_VALIDATION=1 tsx scripts/db-reset.ts test",
    "db:guard:local": "SKIP_ENV_VALIDATION=1 tsx scripts/db-provision-reset-guard.ts local",
    "db:guard:preview": "SKIP_ENV_VALIDATION=1 tsx scripts/db-provision-reset-guard.ts preview",
    "db:guard:test": "SKIP_ENV_VALIDATION=1 tsx scripts/db-provision-reset-guard.ts test",
    "db:studio": "drizzle-kit studio --config=../../drizzle.config.ts",
    "db:studio:local": "drizzle-kit studio --config=../../drizzle.local.config.ts",
    "db:studio:preview": "drizzle-kit studio --config=../../drizzle.preview.config.ts",
    "db:studio:prod": "drizzle-kit studio --config=../../drizzle.production.config.ts",
    "db:studio:test": "drizzle-kit studio --config=../../drizzle.test.config.ts",
    "db:test:local": "tsx scripts/db-test-connection.ts local",
    "db:test:preview": "tsx scripts/db-test-connection.ts preview",
    "db:test:prod": "tsx scripts/db-test-connection.ts production",
    "dev": "next dev",
    "lint": "eslint . --max-warnings 0 --config ../../eslint.config.mjs",
    "lint:fix": "eslint . --fix --max-warnings 0 --config ../../eslint.config.mjs",
    "preview": "next build && next start",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "integrations:check": "tsx scripts/check-integrations.ts",
    "clean": "rm -rf .next && rm -rf node_modules",
    "test": "vitest",
    "test:run": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
