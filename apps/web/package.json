    "nodemailer": "^9.0.3",
    "postgres": "^3.4.9",
    "posthog-js": "^1.399.5",
    "posthog-node": "^5.41.0",
    "react": "19.2.7",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.7",
    "react-email": "^6.8.1",
    "react-image-crop": "^11.1.2",
    "react-intersection-observer": "^10.1.0",
    "react-is": "^19.2.7",
