# Copy to .env.local for local development. Never commit real credentials.
# Keep this file in sync with src/env.js.

# Application URLs
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/discuno

# Better Auth
BETTER_AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
NEXT_PUBLIC_AUTH_GOOGLE_ID=
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=

# Email (Resend)
AUTH_EMAIL_FROM=Discuno <auth@example.com>
ADMIN_ALERT_EMAIL=support@example.com
RESEND_API_KEY=

# Cal.com platform API (NEXT_PUBLIC_X_CAL_ID is the platform client ID)
NEXT_PUBLIC_CALCOM_API_URL=https://api.cal.com/v2
NEXT_PUBLIC_X_CAL_ID=
X_CAL_SECRET_KEY=
CALCOM_ORG_ID=
COLLEGE_MENTOR_TEAM_ID=
CALCOM_WEBHOOK_SECRET=

# Stripe
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
# Server-side launch/incident switch. Keep false until preview E2E and production gates pass.
PAYMENTS_ENABLED=false

# Background jobs (Inngest)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Redis / rate limiting (Upstash)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# File storage (Vercel Blob)
BLOB_READ_WRITE_TOKEN=

# Analytics (PostHog)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_UI_HOST=https://us.posthog.com

# Protected cron routes
CRON_SECRET=

# Destructive development tooling is opt-in
# SEED_EXTERNAL_ACCOUNTS=true
# ALLOW_EXTERNAL_ACCOUNT_CLEANUP=true
# ALLOW_PROD_SEEDING=true
