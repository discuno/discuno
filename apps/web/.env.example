# Copy to .env.local for local development. Never commit real credentials.
# Keep this file in sync with src/env.js.

# Application URLs
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/discuno

# Better Auth
# Configure at least one of BETTER_AUTH_SECRET or BETTER_AUTH_SECRETS. The
# legacy secret may be the sole key only for an unrotated legacy deployment;
# during migration retain it separately for pre-envelope values, not as a new
# versioned-ring entry.
BETTER_AUTH_SECRET=
# Preferred rotation ring. The first entry encrypts new data and keys OTP
# digests; later entries are decryption-only. Generate each value with:
# openssl rand -base64 32
# BETTER_AUTH_SECRETS=2:<new-secret>,1:<previous-secret>
# Dedicated OAuth-proxy secret. Use the same 32+ character value in local,
# preview, and production; keep Better Auth key material unique per environment.
OAUTH_PROXY_SECRET=
BETTER_AUTH_PRODUCTION_URL=https://discuno.com
# Optional comma-separated allowlist for stable preview/custom origins.
# Shared-host origins such as *.vercel.app must be listed exactly. Wildcards
# are allowed only on custom domains you control.
# BETTER_AUTH_TRUSTED_ORIGINS=https://discuno-web-git-main-example.vercel.app
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
NEXT_PUBLIC_AUTH_GOOGLE_ID=
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=

# Email (Resend)
AUTH_EMAIL_FROM=Discuno <auth@example.com>
ADMIN_ALERT_EMAIL=support@example.com
RESEND_API_KEY=

# Cal.com standard OAuth (create an approved client at app.cal.com/settings/developer/oauth)
CALCOM_API_URL=https://api.cal.com/v2
CALCOM_APP_URL=https://app.cal.com
CALCOM_OAUTH_CLIENT_ID=
CALCOM_OAUTH_CLIENT_SECRET=
# Keep the prior client secret here only during a zero-downtime secret rotation.
# CALCOM_OAUTH_CLIENT_SECRET_FALLBACK=
CALCOM_OAUTH_REDIRECT_URI=http://localhost:3000/api/integrations/calcom/callback
# Generate with: openssl rand -base64 32
CALCOM_TOKEN_ENCRYPTION_KEY=
# Keep the prior key while stored credentials are being rotated.
# CALCOM_TOKEN_ENCRYPTION_KEY_PREVIOUS=
# Optional stable override; defaults to NEXT_PUBLIC_BASE_URL/api/webhooks/cal.
# It must be publicly provider-reachable and not protected by Vercel SSO.
# CALCOM_WEBHOOK_URL=https://example.com/api/webhooks/cal
# Legacy-only shared signing secret. Leave unset while the migration switch is false.
# CALCOM_WEBHOOK_SECRET=
# Temporary migration switch only. Enabling it requires CALCOM_WEBHOOK_SECRET.
CALCOM_ALLOW_LEGACY_SHARED_WEBHOOKS=false

# Stripe
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
# Server-side launch/incident switch. Keep false until preview E2E and production gates pass.
PAYMENTS_ENABLED=false

# Background jobs (Inngest)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Redis / rate limiting (Upstash)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# File storage (Vercel Blob)
BLOB_READ_WRITE_TOKEN=

# Analytics (PostHog)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_UI_HOST=https://us.posthog.com

# Protected cron routes
CRON_SECRET=

# Destructive development tooling is opt-in
# SEED_EXTERNAL_ACCOUNTS=true
# ALLOW_EXTERNAL_ACCOUNT_CLEANUP=true
# ALLOW_PROD_SEEDING=true
